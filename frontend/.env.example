API_ORIGIN=http://localhost:4000
# Extra hosts next/image may optimize (comma separated). Supabase Storage is
# added automatically from NEXT_PUBLIC_SUPABASE_URL.
IMAGE_REMOTE_HOSTS=
# Public URL of the Supabase project; uploads are served from
# <NEXT_PUBLIC_SUPABASE_URL>/storage/v1/object/public/<bucket>/…
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_UPLOAD_BUCKET=uploads

# server
NODE_ENV=development
PORT=4000
RUN_MIGRATIONS=true
FRONTEND_URL=
# Temporary: add clientIp/forwardedFor to request logs, then turn it back off.
TRUST_PROXY_DIAGNOSTIC=false

# database (local Supabase CLI default)
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
TEST_DATABASE_URL=
# Optional PEM CA for a production DB provider; write newlines as \n
DB_SSL_CA=

# secrets
JWT_USER_SECRET=
JWT_ADMIN_SECRET=
OTP_PEPPER=

# seeded super admin (created on first boot; every other admin is created in the dashboard)
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PASSWORD=

# mail (MAIL_TRANSPORT=log prints messages instead of sending; resend sends over HTTPS)
MAIL_TRANSPORT=log
RESEND_API_KEY=
EMAIL_FROM=no-reply@example.com
EMAIL_FROM_NAME=DCITC
CONTACT_TO=

# google oauth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

# storage
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
UPLOAD_BUCKET=uploads

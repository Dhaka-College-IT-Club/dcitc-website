# server
NODE_ENV=development
PORT=4000
RUN_MIGRATIONS=true
FRONTEND_URL=

# database (local Supabase CLI default)
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
TEST_DATABASE_URL=
# Optional PEM CA for a production DB provider; write newlines as \n
DB_SSL_CA=

# secrets
JWT_USER_SECRET=
JWT_ADMIN_SECRET=
OTP_PEPPER=

# seeded super admin (created on first boot; every other admin is created in the dashboard)
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PASSWORD=

# mail (MAIL_TRANSPORT=log prints messages instead of sending)
MAIL_TRANSPORT=log
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
CONTACT_TO=

# google oauth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

# storage
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
UPLOAD_BUCKET=uploads
